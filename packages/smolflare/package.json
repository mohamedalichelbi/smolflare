{
	"name": "smolflare",
	"version": "0.1.0",
	"description": "Portable storage and self-hosting tools for Worker applications",
	"keywords": [
		"cloudflare",
		"miniflare",
		"self-hosted",
		"workers"
	],
	"license": "MIT OR Apache-2.0",
	"files": [
		"dist"
	],
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "node -r esbuild-register tools/build.ts && tsc -p tsconfig.build.json",
		"check:type": "tsc",
		"test": "vitest run",
		"test:package": "pnpm run build && node -r esbuild-register tools/test-package.ts",
		"test:ci": "vitest run"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1120.0",
		"@aws-sdk/lib-storage": "3.1120.0",
		"@azure/storage-blob": "12.33.0",
		"@google-cloud/storage": "7.22.0"
	},
	"devDependencies": {
		"@cloudflare/workers-utils": "workspace:*",
		"@types/node": "catalog:default",
		"esbuild": "catalog:default",
		"esbuild-register": "^3.5.0",
		"miniflare": "workspace:*",
		"typescript": "catalog:default",
		"vitest": "catalog:default"
	}
}
